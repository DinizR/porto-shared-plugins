<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>systems.porto</groupId>
        <artifactId>porto-shared-plugins</artifactId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>e-sign-docusign</artifactId>
    <version>1.0.0</version>
    <dependencies>
        <dependency>
            <groupId>systems.porto</groupId>
            <artifactId>porto-api-common</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>systems.porto</groupId>
            <artifactId>shine-media-dtos</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>systems.porto</groupId>
            <artifactId>adapters</artifactId>
            <version>${porto.core.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>systems.porto</groupId>
            <artifactId>context</artifactId>
            <version>${porto.core.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target xmlns:if="ant:if">17</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target xmlns:if="ant:if">
                            <condition property="plugin.deploy.ready">
                                <not><equals arg1="${porto.api.home}" arg2="" trim="true"/></not>
                            </condition>
                                <mkdir dir="${porto.api.home}/plugins/client-adapters/shared" if:set="plugin.deploy.ready"/>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      tofile="${porto.api.home}/plugins/client-adapters/shared/${project.build.finalName}.jar" if:set="plugin.deploy.ready"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
